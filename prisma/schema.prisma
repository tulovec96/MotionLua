// RobloAI data model.
// Auth.js (NextAuth v5) Prisma-adapter shape (User/Account/Session/VerificationToken)
// extended with billing/domain fields, plus chat, usage, billing, and Studio-bridge models.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js + billing identity
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ULTRA
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Roblox identity (the actual sign-in identity — email above is unused by
  // the Roblox OAuth flow since Roblox does not expose one).
  robloxId       String  @unique
  robloxUsername String
  displayName    String?
  avatarUrl      String?

  // Billing / token metering
  plan              Plan     @default(FREE)
  tokenBalance      Int      @default(10000)
  monthlyAllocation Int      @default(10000)
  monthlyUsed       Int      @default(0)
  cycleStart        DateTime @default(now())
  cycleEnd          DateTime?
  rolloverTokens    Int      @default(0)
  stripeCustomerId  String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]
  usageEvents   UsageEvent[]
  transactions  Transaction[]
  bridgeSessions BridgeSession[]

  @@index([robloxId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  // Encrypted at rest — see lib/auth/encryption.ts. Never decrypted into a
  // session object; only read server-side for a future token-refresh call.
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  usageEvents UsageEvent[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  // Full serialized content: for assistant messages this is the complete
  // trace (text + thinking + step events) so history replays identically to
  // the original live stream, not just the final text.
  content   Json
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------------------------------------------------------------------------
// Token usage + billing
// ---------------------------------------------------------------------------

model UsageEvent {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String?
  model           String
  inputTokens     Int
  outputTokens    Int
  reasoningTokens Int      @default(0)
  toolCalls       Int      @default(0)
  totalUnits      Int
  createdAt       DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum TransactionType {
  SUBSCRIPTION
  TOKEN_PACK
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  amountCents     Int
  tokensGranted   Int
  stripePaymentId String?           @unique
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Roblox Studio bridge (plugin pairing + command queue)
// ---------------------------------------------------------------------------

enum BridgeSessionStatus {
  PENDING
  CONNECTED
  EXPIRED
}

model BridgeSession {
  id              String              @id @default(cuid())
  userId          String
  pairingCode     String              @unique
  status          BridgeSessionStatus @default(PENDING)
  placeId         String?
  placeName       String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime            @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands BridgeCommand[]

  @@index([userId, status])
}

enum BridgeCommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
}

model BridgeCommand {
  id              String              @id @default(cuid())
  bridgeSessionId String
  type            String
  payload         Json
  status          BridgeCommandStatus @default(QUEUED)
  result          Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bridgeSession BridgeSession @relation(fields: [bridgeSessionId], references: [id], onDelete: Cascade)

  @@index([bridgeSessionId, status])
}
