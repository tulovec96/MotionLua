# Copy this file to .env and fill in what you have. RobloAI is designed to run
# with NONE of these set: auth falls back to a "Continue as Dev User" mock
# login, billing falls back to a mock Stripe client, the AI chat falls back to
# a scripted mock model, and Roblox Studio tool calls fall back to seeded mock
# results. Fill in real values incrementally as you get credentials.

# ---------------------------------------------------------------------------
# Database (required — see README for local Postgres setup)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://robloai:robloai_dev_password@localhost:5432/robloai?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of this app, used for OAuth callback construction.
AUTH_URL="http://localhost:3000"

# 32-byte base64 key used to encrypt OAuth refresh tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Roblox OAuth 2.0 (Creator Dashboard -> your app -> OAuth tab)
# https://create.roblox.com/dashboard/credentials
# Redirect URI to register: http://localhost:3000/api/auth/callback/roblox
# Leave both unset to use the dev-mode mock login instead.
# ---------------------------------------------------------------------------
ROBLOX_CLIENT_ID=""
ROBLOX_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Anthropic (Vercel AI SDK provider). Leave unset to use the mock model,
# which streams a canned multi-step trace so the chat UI is fully demoable.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Stripe. Leave unset to use the mock billing client (fake checkout URLs that
# resolve immediately, no real charges).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs from your Stripe dashboard, one per paid plan/pack.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ULTRA=""
STRIPE_PRICE_PACK_STARTER=""
STRIPE_PRICE_PACK_STANDARD=""
STRIPE_PRICE_PACK_PRO=""
STRIPE_PRICE_PACK_MEGA=""

# ---------------------------------------------------------------------------
# Roblox Marketplace / Catalog API. No key required for the public catalog
# endpoints; set MARKETPLACE_MODE=mock to force the local fixture set (useful
# when outbound network access to Roblox's APIs isn't available).
# ---------------------------------------------------------------------------
MARKETPLACE_MODE="live"

# ---------------------------------------------------------------------------
# Roblox Studio bridge — base URL the plugin polls. Only needs to change for
# a non-localhost deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Standalone MCP server (npm run mcp:server) only. Opts tool calls made
# through Claude Code/Desktop into routing via that account's paired Studio
# plugin (see lib/bridge/client.ts); leave unset to use mock results only.
# ---------------------------------------------------------------------------
ROBLOAI_USER_ID=""
